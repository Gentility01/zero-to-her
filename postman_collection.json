            "url": {
              "raw": "{{base_url}}/v2/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "users"
              ]
            }
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v2/users/{{user_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "users",
                "{{user_id}}"
              ]
            }
          }
        },
        {
          "name": "Update user (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v2/users/{{user_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "users",
                "{{user_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"last_name\": \"User\"\n}"
